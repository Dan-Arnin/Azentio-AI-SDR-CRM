# Secrets: never commit real environment files or credentials
.env
.env.*
!.env.example
*.pem
*.key
auth.json
# Local runtime data (lead records, email content, demo clock)
data/
*.sqlite3
*.sqlite3-*
*.db
# Python / tooling
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.claude/
.DS_Store
# Sanitized demo seed data is intentionally committed
!seed-data/
!seed-data/*.sqlite3
