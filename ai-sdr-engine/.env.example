# Copy to .env (never commit .env). Values here are placeholders only.

# OpenAI (server-side only). With a key: Decisions API + Agents SDK + web search.
OPENAI_API_KEY=
LLM_BACKEND=api_key
GENERATION_MODEL=gpt-6-luna
JUDGE_MODEL=gpt-6-luna
DECISION_MODEL=gpt-6-luna
DECISION_PROVIDER=openai_decisions
INTENT_CONFIDENCE_FLOOR=0.85
EVIDENCE_CONFIDENCE_FLOOR=0.6

# Email (Resend). Sends only go to DEMO_INBOX, a controlled test inbox.
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
EMAIL_FROM=Azentio team <onboarding@resend.dev>
DEMO_INBOX=
REPLY_TO=
SENDER_NAME=Azentio team
SENDER_TITLE=Sales Development

# CRM webhook push (optional; empty = built-in mock CRM)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Storage and demo behaviour
DB_PATH=data/sdr.sqlite3
DEMO_MODE=true
DEMO_TIMEZONE=Asia/Kolkata
POLICY_VERSION=demo-icp-v2
DEFAULT_AE_OWNER=ae.sara
DEFAULT_SDR_OWNER=sdr.omar
